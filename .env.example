# DataMCP Agent Configuration

# Required: Agent API key from DataMCP dashboard
DATAMCP_API_KEY=agent_your_api_key_here

# Optional: DataMCP cloud WebSocket URL
DATAMCP_CLOUD_URL=wss://api.datamcp.com

# Optional: Friendly name for the agent
AGENT_NAME=My Agent

# Optional: Heartbeat interval in milliseconds (default: 30000)
HEARTBEAT_INTERVAL=30000

# Optional: Log level (debug, info, warn, error)
LOG_LEVEL=info

# Optional: HTTP port for health checks (default: 3000)
PORT=3000
