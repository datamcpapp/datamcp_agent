# ── DataMCP Agent configuration ───────────────────────────────────────────────
# Copy to .env and fill in. The agent runs INSIDE your network, holds your DB
# credentials locally, and connects OUTBOUND to the DataMCP cloud over a
# websocket. Your database is never exposed to the internet.

# ── Which cloud to talk to ────────────────────────────────────────────────────
# Mirrors the server/dashboard convention: one build, switch environments with a
# flag. `qa` is for testing the tunnel against the QA cloud before going live.
#   production | qa | staging | development
DATAMCP_STAGE=production

# Optional: override the resolved cloud URL entirely (advanced / self-hosted cloud).
# When set, DATAMCP_STAGE is ignored for URL resolution.
# DATAMCP_CLOUD_URL=wss://api.datamcp.app

# ── Identity: how this agent authenticates to the cloud ───────────────────────
# The connection this agent serves (from the DataMCP dashboard).
DATAMCP_CONNECTION_ID=conn_xxxxxxxxxxxxxxxx

# Provide exactly ONE of the following, depending on onboarding flow:
#   DATAMCP_API_KEY   — registered flow (recommended for production)
#   DATAMCP_ANON_TOKEN — anonymous bootstrap flow (claim later from the dashboard)
DATAMCP_API_KEY=agent_your_api_key_here
# DATAMCP_ANON_TOKEN=

# ── The database this agent reaches (stays on YOUR side) ──────────────────────
DATABASE_URL=postgresql://user:password@db.internal.example.com:5432/mydb

# ── Safety ────────────────────────────────────────────────────────────────────
# When true (default) the agent runs every query inside a READ ONLY transaction
# and blocks dangerous functions — a hard backstop so the tunnel cannot be used
# to write to or damage your database. Only set false for an explicitly
# read-write connection.
AGENT_READ_ONLY=true

# Per-query statement timeout (ms). Caps runaway/DoS queries.
AGENT_STATEMENT_TIMEOUT_MS=30000

# ── Operational ───────────────────────────────────────────────────────────────
AGENT_NAME=my-agent
HEARTBEAT_INTERVAL_MS=30000
LOG_LEVEL=info
# Local HTTP port for liveness/health probes (Docker, k8s).
HEALTH_PORT=3000
