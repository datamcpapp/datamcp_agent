# ── DataMCP Agent — environment fallbacks ─────────────────────────────────────
# Everything here can also be passed on the CLI, which takes precedence:
#   npx datamcp <ro|rwd|fa> <database-url> [options]
# The agent runs INSIDE your network, keeps DB credentials local, and connects
# OUTBOUND to the DataMCP cloud. Your database is never exposed to the internet.

# Access policy (the agent's local enforcement ceiling): ro | rwd | fa
DATAMCP_POLICY=ro

# The database this agent reaches (stays on YOUR side).
DATABASE_URL=postgresql://user:password@db.internal.example.com:5432/mydb

# Which cloud to talk to: production | qa | staging | development
DATAMCP_STAGE=production
# Optional explicit override (ignores stage for URL resolution):
# DATAMCP_CLOUD_URL=wss://api.datamcp.app

# Identity (required to actually tunnel; not needed for --selftest):
DATAMCP_CONNECTION_ID=conn_xxxxxxxxxxxxxxxx
DATAMCP_API_KEY=agent_your_api_key_here
# DATAMCP_ANON_TOKEN=            # anonymous bootstrap; claim later in the dashboard

# Operational
AGENT_STATEMENT_TIMEOUT_MS=30000
AGENT_NAME=my-agent
HEARTBEAT_INTERVAL_MS=30000
LOG_LEVEL=info
HEALTH_PORT=3000
