# DataMCP Agent Configuration

# Required: PostgreSQL URL, connection ID, and scoped agent token from DataMCP dashboard
DATAMCP_DB_URL=postgresql://user:password@localhost:5432/app
DATAMCP_CONNECTION_ID=conn_your_connection_id_here
DATAMCP_AGENT_TOKEN=agent_your_token_here

# Recommended: keep writes blocked unless you explicitly need them
DATAMCP_READ_ONLY=true

# Optional: cosmetic display name (defaults to this machine's hostname)
# AGENT_NAME=My Agent

# Optional: Heartbeat interval in milliseconds (default: 30000)
# HEARTBEAT_INTERVAL=30000

# Optional: Log level (debug, info, warn, error; default: info)
# LOG_LEVEL=info

# Optional: HTTP port for health checks (default: 3000)
# PORT=3000
